---
import { site, type Locale } from "../../data/site";
import type { UiKey } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import { buildDemoWhatsAppUrl } from "../../lib/whatsapp";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const max = site.reservation.maxPartySize;
const slots = site.reservation.slots;
const occasions = site.reservation.occasions;

const toIso = (date: Date) =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(
    date.getDate(),
  ).padStart(2, "0")}`;

const start = new Date();
start.setDate(start.getDate() + site.reservation.minLeadDays);
const end = new Date();
end.setDate(end.getDate() + site.reservation.maxLeadDays);
const minDate = toIso(start);
const maxDate = toIso(end);

const fallbackUrl = buildDemoWhatsAppUrl(
  `${t("msg.intro")} ${t("msg.footer")}`,
);
const largerTitle = t("reservation.largerTitle").replace("{max}", String(max));

const chipClass =
  "inline-flex min-h-10 cursor-pointer items-center rounded-full border border-border px-3 text-sm peer-checked:border-primary peer-checked:bg-primary peer-checked:text-on-primary peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus";
---

<form
  data-reservation-form
  id="reservation"
  class="mt-8 grid gap-6 lg:grid-cols-[1.15fr_1fr] lg:items-start"
>
  <div class="space-y-4">
    <div class="card p-4">
      <p class="font-heading text-lg">{t("reservation.partySize")}</p>
      <div class="mt-3 flex items-center gap-4">
        <button
          type="button"
          data-party-decrease
          class="btn btn-outline !min-h-11 !w-11 !px-0 text-xl"
          aria-label={t("reservation.decrease")}
        >
          −
        </button>
        <span
          data-party-value
          class="min-w-10 text-center font-heading text-4xl tabular-nums"
          aria-live="polite">2</span
        >
        <button
          type="button"
          data-party-increase
          class="btn btn-outline !min-h-11 !w-11 !px-0 text-xl"
          aria-label={t("reservation.increase")}
        >
          +
        </button>
      </div>
      <input type="hidden" name="partySize" data-party-input value="2" />
      <p class="mt-3 text-xs text-text-muted">{t("reservation.partyHint")}</p>
    </div>

    <div class="card p-4">
      <label for="res-date" class="block font-heading text-lg">
        {t("reservation.date")}
      </label>
      <input
        id="res-date"
        name="date"
        type="date"
        min={minDate}
        max={maxDate}
        data-date
        class="input mt-2"
      />
      <p class="mt-1 text-xs text-text-muted">{t("reservation.dateHint")}</p>
    </div>

    <div class="card p-4">
      <p id="res-time-label" class="font-heading text-lg">
        {t("reservation.time")}
      </p>
      <div
        class="mt-3 flex flex-wrap gap-2"
        role="radiogroup"
        aria-labelledby="res-time-label"
      >
        <label class="relative">
          <input
            type="radio"
            name="slot"
            value="any"
            data-slot
            checked
            class="peer sr-only"
          />
          <span class={chipClass}>{t("reservation.timeAny")}</span>
        </label>
        {
          slots.map((slot) => (
            <label class="relative">
              <input
                type="radio"
                name="slot"
                value={slot}
                data-slot
                class="peer sr-only"
              />
              <span class={chipClass}>{slot}</span>
            </label>
          ))
        }
      </div>
      <p class="mt-2 text-xs text-text-muted">{t("reservation.timeHint")}</p>
    </div>

    <div class="card p-4">
      <label for="res-occasion" class="block font-heading text-lg">
        {t("reservation.occasion")}
      </label>
      <select
        id="res-occasion"
        name="occasion"
        data-occasion
        class="input mt-2"
      >
        {
          occasions.map((occasion) => (
            <option value={occasion}>
              {t(`occasion.${occasion}` as UiKey)}
            </option>
          ))
        }
      </select>
      <p class="mt-1 text-xs text-text-muted">
        {t("reservation.occasionHint")}
      </p>
    </div>
  </div>

  <aside class="space-y-4 lg:sticky lg:top-28">
    <div class="card space-y-4 p-4">
      <div>
        <label for="res-name" class="block text-sm font-medium">
          {t("reservation.name")}{" "}
          <span class="font-normal text-text-muted"
            >({t("common.optional")})</span
          >
        </label>
        <input
          id="res-name"
          name="name"
          type="text"
          data-name
          class="input mt-1"
          placeholder={t("reservation.namePlaceholder")}
          autocomplete="name"
        />
      </div>

      <div>
        <label for="res-phone" class="block text-sm font-medium">
          {t("reservation.phone")}{" "}
          <span class="font-normal text-text-muted"
            >({t("common.optional")})</span
          >
        </label>
        <input
          id="res-phone"
          name="phone"
          type="tel"
          data-phone
          class="input mt-1"
          placeholder={t("reservation.phonePlaceholder")}
          autocomplete="tel"
        />
      </div>

      <div>
        <label for="res-notes" class="block text-sm font-medium">
          {t("reservation.notes")}{" "}
          <span class="font-normal text-text-muted"
            >({t("common.optional")})</span
          >
        </label>
        <textarea
          id="res-notes"
          name="notes"
          rows="3"
          data-notes
          class="input mt-1"
          placeholder={t("reservation.notesPlaceholder")}></textarea>
      </div>

      <button
        type="submit"
        data-reservation-send
        class="btn btn-primary w-full"
      >
        {t("reservation.send")}
      </button>
      <p class="text-xs text-text-muted">{t("reservation.noPayment")}</p>

      <noscript>
        <a
          href={fallbackUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline w-full"
          data-wa
        >
          {t("common.chatOnWhatsApp")}
        </a>
      </noscript>
    </div>

    <div class="card p-4">
      <h2 class="font-heading text-lg">{largerTitle}</h2>
      <p class="mt-1 text-sm text-text-muted">{t("reservation.largerBody")}</p>
      <button
        type="button"
        data-larger-send
        class="btn btn-outline mt-3 w-full"
      >
        {t("reservation.largerCta")}
      </button>
    </div>
  </aside>
</form>
