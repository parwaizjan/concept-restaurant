---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";
import OpeningHours from "../visit/OpeningHours.astro";
import MapEmbed from "../visit/MapEmbed.astro";
import ContactLinks from "../visit/ContactLinks.astro";
import OrderingLinks from "../visit/OrderingLinks.astro";
import { type Locale } from "../../data/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const entry =
  (await getEntry("pages", `visit/${lang}`)) ??
  (await getEntry("pages", "visit/en"));

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout lang={lang} path="/visit" title={entry?.data.title}>
  <section class="container-page py-12">
    <div class="mx-auto max-w-4xl">
      <h1 class="font-heading text-4xl">{entry?.data.title}</h1>
      <div class="mt-3 leading-relaxed text-text-muted">
        {Content && <Content />}
      </div>

      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <div class="space-y-8">
          <ContactLinks lang={lang} />
          <OpeningHours lang={lang} />
        </div>
        <MapEmbed lang={lang} />
      </div>

      <div class="mt-10 border-t border-border pt-8">
        <OrderingLinks lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>
