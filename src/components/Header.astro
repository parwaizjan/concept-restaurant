---
import { site, type Locale } from "../data/site";
import { isLocale, useTranslations, localizePath } from "../i18n/utils";
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { key: "nav.menu", href: "/menu" },
  { key: "nav.reserve", href: "/reserve" },
  { key: "nav.gallery", href: "/gallery" },
  { key: "nav.about", href: "/about" },
  { key: "nav.visit", href: "/visit" },
] as const;

// The locale-less path for the current page, so nav items can be marked active.
const pathParts = Astro.url.pathname.split("/").filter(Boolean);
if (isLocale(pathParts[0])) pathParts.shift();
const logicalPath = `/${pathParts.join("/")}`.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  const target = href === "/" ? "/" : href.replace(/\/+$/, "");
  return (
    logicalPath === target ||
    (target !== "/" && logicalPath.startsWith(`${target}/`))
  );
};

const linkClass = (active: boolean) =>
  [
    "inline-flex min-h-9 items-center whitespace-nowrap rounded-full px-3 text-sm font-medium",
    active
      ? "bg-surface-alt text-primary"
      : "text-text-muted hover:bg-surface-alt hover:text-text",
  ].join(" ");
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-3 py-2.5">
    <a
      href={localizePath("/", lang)}
      class="flex items-center gap-2"
      aria-label={site.name}
    >
      <img src={site.logo} alt="" width="36" height="36" />
      <span class="whitespace-nowrap font-heading text-lg sm:text-xl"
        >{site.name}</span
      >
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label={t("nav.menu")}>
      {
        links.map((link) => (
          <a
            href={localizePath(link.href, lang)}
            aria-current={isActive(link.href) ? "page" : undefined}
            class={linkClass(isActive(link.href))}
          >
            {t(link.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitcher lang={lang} />
      <a
        href={localizePath("/reserve", lang)}
        class="btn btn-primary !min-h-10 whitespace-nowrap !px-3 text-sm sm:!px-4"
      >
        <span class="sm:hidden">{t("nav.reserve")}</span>
        <span class="hidden sm:inline">{t("common.reserveNow")}</span>
      </a>
    </div>
  </div>

  <nav class="container-page md:hidden" aria-label={t("nav.menu")}>
    <ul class="no-scrollbar flex gap-1 overflow-x-auto py-1.5">
      {
        links.map((link) => (
          <li>
            <a
              href={localizePath(link.href, lang)}
              aria-current={isActive(link.href) ? "page" : undefined}
              class={linkClass(isActive(link.href))}
            >
              {t(link.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
